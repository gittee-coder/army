#!/usr/bin/env python3
"""推一张 IM 审批卡片到 Army 群 —— Auditor LGTM 后调，闭合"最后一拍人审"。

按钮 value 对齐 feishu-bridge.on_card 的约定：{action: merge|diff|reject, repo, pr, issue}。
人在 IM 点【批准合并】→ bridge 跑 `gh pr merge`；点【看 diff】→ 回传 diff；【拒绝】→ 评论打回。

用法：army-approve-card <repo> <pr> [issue]
    repo 形如 your-org/repo。title/url 自动用 gh 拉。
    gh 用其自身 auth；org 仓如需 org-scoped token，运行前 export GH_TOKEN。
"""
import sys, os, json, subprocess

GH = os.environ.get("GH_BIN", "gh")
SEND = os.path.expanduser("~/army/bin/feishu-send")


def gh_env(repo):
    # gh CLI 用自身 auth；org 仓如需 org-scoped token，运行前 export GH_TOKEN。
    return dict(os.environ)


def pr_meta(repo, pr):
    try:
        r = subprocess.run([GH, "pr", "view", str(pr), "--repo", repo,
                            "--json", "title,url"], capture_output=True, text=True,
                           env=gh_env(repo), timeout=30)
        d = json.loads(r.stdout or "{}")
        return d.get("title", ""), d.get("url", "")
    except Exception:
        return "", ""


def build_card(repo, pr, issue, title, url):
    closes = f"  ·  Closes #{issue}" if issue else ""
    link = f"\n[在 GitHub 查看 ->]({url})" if url else ""
    desc = (f"**{repo}** · PR #{pr}{closes}\n"
            f"{title}{link}\n\n"
            f"Auditor 已 LGTM，请审批：")
    val_merge = {"action": "merge", "repo": repo, "pr": pr}
    val_diff = {"action": "diff", "repo": repo, "pr": pr}
    val_reject = {"action": "reject", "repo": repo, "pr": pr}
    if issue:
        val_merge["issue"] = issue
        val_reject["issue"] = issue
    return {
        "config": {"wide_screen_mode": True},
        "header": {"template": "green",
                   "title": {"tag": "plain_text", "content": "待审批合并"}},
        "elements": [
            {"tag": "markdown", "content": desc},
            {"tag": "action", "actions": [
                {"tag": "button", "text": {"tag": "plain_text", "content": "批准合并"},
                 "type": "primary", "value": val_merge},
                {"tag": "button", "text": {"tag": "plain_text", "content": "看 diff"},
                 "type": "default", "value": val_diff},
                {"tag": "button", "text": {"tag": "plain_text", "content": "拒绝"},
                 "type": "danger", "value": val_reject},
            ]},
        ],
    }


def main():
    if len(sys.argv) < 3:
        print("用法: army-approve-card <repo> <pr> [issue]", file=sys.stderr)
        sys.exit(2)
    repo, pr = sys.argv[1], sys.argv[2]
    issue = sys.argv[3] if len(sys.argv) > 3 else ""
    title, url = pr_meta(repo, pr)
    card = build_card(repo, pr, issue, title, url)
    p = subprocess.run([SEND, "--card"], input=json.dumps(card, ensure_ascii=False),
                       text=True, capture_output=True, timeout=30)
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    sys.exit(p.returncode)


if __name__ == "__main__":
    main()
