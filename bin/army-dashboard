      {stats["total"]} 条记录 · {stats["active_days"]} 活跃日
    </div>
  </div>
</footer>

<script>
// 顶部 tab 切换：默认 roles；hash 同步以便分享深链
(function(){{
  var nav = document.querySelectorAll('#tabnav button');
  var panels = document.querySelectorAll('.tab-panel');
  function show(t){{
    var ok = false;
    nav.forEach(function(b){{
      var on = b.getAttribute('data-tab')===t;
      b.classList.toggle('on', on);
      if (on) ok = true;
    }});
    if (!ok) {{ t = 'roles'; nav[0] && nav[0].classList.add('on'); }}
    panels.forEach(function(p){{ p.classList.toggle('on', p.getAttribute('data-tab')===t); }});
    if (location.hash.replace('#','') !== t) {{
      history.replaceState(null, '', '#'+t);
    }}
  }}
  nav.forEach(function(b){{
    b.addEventListener('click', function(){{
      show(b.getAttribute('data-tab'));
      window.scrollTo({{top:0,behavior:'instant'}});
    }});
  }});
  var initial = (location.hash||'').replace('#','') || 'roles';
  show(initial);
  window.addEventListener('hashchange', function(){{
    show((location.hash||'').replace('#','') || 'roles');
  }});
}})();

// 时间线角色筛选（数据已内联，纯前端交互）
(function(){{
  var RUNS = {data_json};   // 脱敏后的完整记录（供调试 / 后续扩展）
  var log = document.getElementById('log');
  var btns = document.querySelectorAll('#filters button');
  function apply(f){{
    var rows = log.querySelectorAll('.log-row');
    rows.forEach(function(r){{
      r.style.display = (f==='all' || r.getAttribute('data-role')===f) ? '' : 'none';
    }});
    // 日期分隔：若该日全部隐藏则一并隐藏
    var seps = log.querySelectorAll('.day-sep');
    seps.forEach(function(sep){{
      var anyVisible=false, el=sep.nextElementSibling;
      while(el && !el.classList.contains('day-sep')){{
        if(el.classList.contains('log-row') && el.style.display!=='none'){{anyVisible=true;break;}}
        el=el.nextElementSibling;
      }}
      sep.style.display = anyVisible ? '' : 'none';
    }});
  }}
  btns.forEach(function(b){{
    b.addEventListener('click', function(){{
      btns.forEach(function(x){{x.classList.remove('on');}});
      b.classList.add('on');
      apply(b.getAttribute('data-f'));
    }});
  }});
}})();
</script>
</body>
</html>
"""


def main() -> int:
    raw = load_runs(LEDGER)
    records = [c for c in (clean_record(r) for r in raw) if c]
    stats = aggregate(records)

    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(build_html(records, stats), encoding="utf-8")

    # ---- 摘要 ----
    print(f"[army-dashboard] 已生成：{OUT}")
    print(f"  源账本           : {LEDGER}")
    print(f"  总记录           : {stats['total']}（{stats['active_days']} 活跃日）")
    rc = stats["role_counts"]
    print(f"  角色分布         : pm={rc.get('pm',0)} worker={rc.get('worker',0)} "
          f"auditor={rc.get('auditor',0)} redline={rc.get('redline',0)}")
    print(f"  成功率           : {stats['success_rate']:.1f}%（{stats['ok_n']}/{stats['with_result_n']} result=ok）")
    print(f"  Worker 累计耗时  : {fmt_dur(stats['worker_secs']) or '0s'}（{stats['pr_runs']} 个 PR）")
    print(f"  红线拦截         : deny={stats['redline_deny']} warn={stats['redline_warn']}")
    print(f"  端到端闭环       : {stats['closed_n']}（issues: {stats['closed_issues']}）")
    return 0


if __name__ == "__main__":
    sys.exit(main())
