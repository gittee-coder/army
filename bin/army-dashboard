#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
army-dashboard — 把运行账本 runs.jsonl 渲染成一个对外公开、自包含的
「AI 军团作战日志看板」HTML，发布到你的站点。

行为：
  1. 读 ~/army/runs.jsonl（每行一个 JSON）
  2. 脱敏：剔除绝对路径 / token / IP；task 中的绝对路径替换为 basename
  3. 聚合统计（总数 / 角色分布 / 成功率 / worker 总耗时 / 红线拦截 / 活跃天数 / 时间线）
  4. 生成完全自包含单文件 HTML（内联 CSS+JS，无外部依赖，无 emoji），数据内联
  5. print 文件路径 + 统计摘要

用法：python3 ~/army/bin/army-dashboard
环境变量：
  ARMY_LEDGER   账本路径（默认 ~/army/runs.jsonl）
  ARMY_OUT      输出 HTML 路径（默认 ~/army/dashboard/index.html；通常 export 指到你的站点仓内，
                由 army-dashboard-sync 推送）
"""
from __future__ import annotations

import html
import json
import os
import re
import sys
from collections import Counter, OrderedDict, defaultdict
from datetime import datetime, timezone, timedelta
from pathlib import Path

HOME = Path.home()
LEDGER = Path(os.environ.get("ARMY_LEDGER", HOME / "army" / "runs.jsonl"))
OUT = Path(os.environ.get("ARMY_OUT", HOME / "army" / "dashboard" / "index.html"))

# 北京时间（CST, UTC+8）展示
CST = timezone(timedelta(hours=8))

ROLES = ("pm", "worker", "auditor", "redline")
ROLE_LABEL = {"pm": "PM", "worker": "Worker", "auditor": "Auditor", "redline": "Redline"}
RESULTS = ("ok", "warn", "deny", "fail")

# ---------------------------------------------------------------------------
# 脱敏
# ---------------------------------------------------------------------------

# 绝对/家目录路径片段（含可选 schema 前缀的不动，纯文件系统路径才打）
_ABS_PATH = re.compile(r"(?<![\w/])(?:/[\w.\-]+){2,}/?|~(?:/[\w.\-]+)+/?")
_IP = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}(?::\d+)?\b")
# 常见 token 形态：长 base64ish / hex / sk- / ghp_ / IM app token 等
_TOKEN = re.compile(
    r"\b(?:sk-[A-Za-z0-9_\-]{12,}|ghp_[A-Za-z0-9]{20,}|gh[posu]_[A-Za-z0-9]{20,}"
    r"|cli_[A-Za-z0-9]{12,}|xoxb-[A-Za-z0-9\-]{12,}|AKIA[A-Z0-9]{12,}"
    r"|[A-Fa-f0-9]{32,}|[A-Za-z0-9_\-]{40,})\b"
)


def _basename_path(m: re.Match) -> str:
    """把命中的绝对路径替换为 basename（保留尾部斜杠语义为目录名）。"""
    p = m.group(0)
    trailing = p.endswith("/")
    base = os.path.basename(p.rstrip("/"))
    if not base:
        return ""
    return base + ("/" if trailing else "")


def sanitize_text(s: str) -> str:
    """对自由文本做脱敏：token → [redacted]，IP → [ip]，绝对路径 → basename。"""
    if not s:
        return s
    s = _TOKEN.sub("[redacted]", s)
    s = _IP.sub("[ip]", s)
    s = _ABS_PATH.sub(_basename_path, s)
    return s


# 操作者通过 IM 直接私聊 PM 的原文消息（例如 "feishu @PM: ..." / "slack @PM: ..."）
# ——这部分包含临时想法、吐槽、未成稿决策，不适合对外公开；只保留"曾发生过对话"这个事实。
_IM_CHAT = re.compile(r"^(?:feishu|slack|im|wechat|dm)\s+@\s*PM\s*[:：]\s*", re.IGNORECASE)


def redact_im_chat(task: str) -> str:
    if _IM_CHAT.match(task or ""):
        return "[IM 私聊 · 内容不对外公开]"
    return task


def sanitize_files(files) -> list[str]:
    """files_touched 已是相对路径，但仍剔除任何意外的绝对路径/敏感串。"""
    out = []
    for f in files or []:
        if not isinstance(f, str):
            continue
        f = sanitize_text(f).strip()
        if f:
            out.append(f)
    return out


# ---------------------------------------------------------------------------
# 读账本
# ---------------------------------------------------------------------------

def load_runs(path: Path) -> list[dict]:
    if not path.exists():
        print(f"!! 账本不存在：{path}", file=sys.stderr)
        return []
    runs = []
    for ln, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        raw = raw.strip()
        if not raw:
            continue
        try:
            rec = json.loads(raw)
        except json.JSONDecodeError as e:
            print(f"!! 第 {ln} 行解析失败，跳过：{e}", file=sys.stderr)
            continue
        if not isinstance(rec, dict):
            continue
        runs.append(rec)
    return runs


def clean_record(rec: dict) -> dict | None:
    """只输出白名单字段并脱敏。"""
    role = rec.get("role")
    if role not in ROLES:
        # 未知角色也保留，但归一化
        role = str(role or "?").lower()
    ts = rec.get("ts")
    out = {
        "ts": ts if isinstance(ts, str) else None,
        "role": role,
        "task": redact_im_chat(sanitize_text(str(rec.get("task", "")))),
    }
    if "issue" in rec and isinstance(rec["issue"], int):
        out["issue"] = rec["issue"]
    if "duration_s" in rec:
        try:
            out["duration_s"] = round(float(rec["duration_s"]), 1)
        except (TypeError, ValueError):
            pass
    res = rec.get("result")
    if res in RESULTS:
        out["result"] = res
    elif res:
        out["result"] = "ok"  # 归一化未知 result
    files = sanitize_files(rec.get("files_touched"))
    if files:
        out["files_touched"] = files
    return out


# ---------------------------------------------------------------------------
# 聚合统计
# ---------------------------------------------------------------------------

def parse_ts(ts: str | None) -> datetime | None:
    if not ts:
        return None
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except ValueError:
        return None


def aggregate(records: list[dict]) -> dict:
    total = len(records)
    role_counts = Counter(r["role"] for r in records)

    # 成功率：只看「作战行」（pm/worker/auditor），ok 占比。
    # redline 行不计入——对守卫而言 deny 是成功的拦截而非失败，混进来会反向拉低分母。
    op_records = [r for r in records if r["role"] != "redline" and "result" in r]
    ok_n = sum(1 for r in op_records if r["result"] == "ok")
    success_rate = (ok_n / len(op_records) * 100) if op_records else 0.0
    with_result = op_records

    # worker 总耗时
    worker_secs = sum(r.get("duration_s", 0) for r in records if r["role"] == "worker")
    worker_runs = [r for r in records if r["role"] == "worker"]

    # 红线：deny 才算"真正拦截"；warn 是演练/告警
    redline = [r for r in records if r["role"] == "redline"]
    redline_deny = sum(1 for r in redline if r.get("result") == "deny")
    redline_warn = sum(1 for r in redline if r.get("result") == "warn")

    # 红线分类：从 task 里抽 RED [...] 标签
    red_cats = Counter()
    for r in redline:
        m = re.search(r"RED\s*\[\s*'([^']+)'\s*\]", r["task"])
        if m:
            red_cats[m.group(1)] += 1

    # 活跃天数（按 CST 日期）
    days = set()
    dts = []
    for r in records:
        dt = parse_ts(r["ts"])
        if dt:
            dts.append(dt)
            days.add(dt.astimezone(CST).date())
    active_days = len(days)
    last_dt = max(dts) if dts else None
    first_dt = min(dts) if dts else None

    # 闭环数：以 issue 维度统计「triage/dispatch + worker PR + auditor review + 审批合并」齐全的 issue
    # 简化口径：被 worker 实跑且 result=ok 的不同 issue 数（已端到端修复并合并）
    closed_issues = sorted({
        r["issue"] for r in records
        if r["role"] == "worker" and r.get("result") == "ok" and isinstance(r.get("issue"), int)
    })

    # issue 维度的完整闭环编排（用于 pipeline 叙事 / 时间线分组）
    issue_track = defaultdict(lambda: defaultdict(int))
    for r in records:
        iss = r.get("issue")
        if isinstance(iss, int):
            issue_track[iss][r["role"]] += 1

    # PR 提及数（worker 行里出现 PR / files_touched）
    pr_runs = [r for r in worker_runs if "files_touched" in r]

    return {
        "total": total,
        "role_counts": dict(role_counts),
        "success_rate": success_rate,
        "ok_n": ok_n,
        "with_result_n": len(with_result),
        "worker_secs": worker_secs,
        "worker_runs": len(worker_runs),
        "pr_runs": len(pr_runs),
        "redline_total": len(redline),
        "redline_deny": redline_deny,
        "redline_warn": redline_warn,
        "red_cats": dict(red_cats.most_common()),
        "active_days": active_days,
        "last_dt": last_dt,
        "first_dt": first_dt,
        "closed_issues": closed_issues,
        "closed_n": len(closed_issues),
        "issue_track": {k: dict(v) for k, v in issue_track.items()},
    }


# ---------------------------------------------------------------------------
# HTML 渲染
# ---------------------------------------------------------------------------

def fmt_dt_cst(dt: datetime | None, with_time=True) -> str:
    if not dt:
        return "—"
    local = dt.astimezone(CST)
    if with_time:
        return local.strftime("%Y-%m-%d %H:%M")
    return local.strftime("%Y-%m-%d")


def fmt_dur(secs: float) -> str:
    if secs <= 0:
        return ""
    if secs < 60:
        return f"{secs:.0f}s"
    m, s = divmod(int(round(secs)), 60)
    return f"{m}m{s:02d}s"


def rel_day_label(dt: datetime, now: datetime) -> str:
    """CST 日期分组标签。"""
    d = dt.astimezone(CST).date()
    today = now.astimezone(CST).date()
    delta = (today - d).days
    wk = "一二三四五六日"[d.weekday()]
    if delta == 0:
        return f"今天 · {d.strftime('%m-%d')} 周{wk}"
    if delta == 1:
        return f"昨天 · {d.strftime('%m-%d')} 周{wk}"
    return f"{d.strftime('%Y-%m-%d')} 周{wk}"


def esc(s) -> str:
    return html.escape(str(s), quote=True)


def build_html(records: list[dict], stats: dict) -> str:
    now = datetime.now(timezone.utc)
    gen_at = fmt_dt_cst(now)

    rc = stats["role_counts"]

    # ---- 时间线：倒序，按 CST 日期分组 ----
    ts_records = [r for r in records if parse_ts(r["ts"])]
    ts_records.sort(key=lambda r: parse_ts(r["ts"]), reverse=True)

    timeline_html = []
    cur_day = None
    for r in ts_records:
        dt = parse_ts(r["ts"])
        day_lbl = rel_day_label(dt, now)
        if day_lbl != cur_day:
            cur_day = day_lbl
            timeline_html.append(
                f'<div class="day-sep"><span class="day-dot"></span>'
                f'<span class="day-lbl">{esc(day_lbl)}</span></div>'
            )
        role = r["role"]
        rlabel = ROLE_LABEL.get(role, role.upper())
        time_s = dt.astimezone(CST).strftime("%H:%M:%S")
        result = r.get("result", "")
        issue = r.get("issue")
        dur = fmt_dur(r.get("duration_s", 0))

        meta_bits = []
        if issue is not None:
            meta_bits.append(f'<span class="chip chip-issue">#{esc(issue)}</span>')
        if dur:
            meta_bits.append(f'<span class="chip chip-dur">{esc(dur)}</span>')
        if result:
            meta_bits.append(f'<span class="chip chip-res chip-{esc(result)}">{esc(result.upper())}</span>')
        meta = "".join(meta_bits)

        files_html = ""
        if r.get("files_touched"):
            chips = "".join(
                f'<code class="filechip">{esc(f)}</code>' for f in r["files_touched"]
            )
            files_html = f'<div class="files">{chips}</div>'

        timeline_html.append(
            f'<div class="log-row" data-role="{esc(role)}">'
            f'<div class="log-rail"><span class="rail-dot rail-{esc(role)}"></span></div>'
            f'<div class="log-body">'
            f'<div class="log-head">'
            f'<span class="role-tag role-{esc(role)}">{esc(rlabel)}</span>'
            f'<time class="log-time">{esc(time_s)}</time>'
            f'<span class="log-meta">{meta}</span>'
            f'</div>'
            f'<div class="log-task">{esc(r["task"])}</div>'
            f'{files_html}'
            f'</div>'
            f'</div>'
        )
    timeline_html = "\n".join(timeline_html)

    # ---- 红线分类 ----
    red_cat_rows = []
    # 友好归并：把"必审批"等后缀差异合并
    norm_map = {}
    for cat, n in stats["red_cats"].items():
        key = re.sub(r"（.*?）", "", cat).strip()
        norm_map[key] = norm_map.get(key, 0) + n
    # 保证四类核心都出现，即便计数为 0
    core = OrderedDict([
        ("git push 到 main/master", "拦截直推主干"),
        ("git force-push", "拦截强制推送"),
        ("改 .env / 密钥凭据文件", "保护密钥凭据"),
        ("删 prod 资源", "阻断生产删除"),
    ])
    matched = set()
    for key, desc in core.items():
        cnt = 0
        for k, n in norm_map.items():
            if key.split(" ")[0] in k or k.startswith(key.split("（")[0][:6]):
                if key == "git push 到 main/master" and "force" in k:
                    continue
                cnt += n
                matched.add(k)
        red_cat_rows.append((key, desc, cnt))

    red_cards = "".join(
        f'<div class="red-card">'
        f'<div class="red-card-top"><span class="red-rule">{esc(key)}</span>'
        f'<span class="red-cnt">{cnt}<small>次</small></span></div>'
        f'<div class="red-desc">{esc(desc)}</div>'
        f'</div>'
        for key, desc, cnt in red_cat_rows
    )

    # ---- 角色卡数据 ----
    role_meta = OrderedDict([
        ("pm", ("PM", "项目经理", "分诊 GitHub Issue，判断是否已解决 / 重复，决定派工并下发任务给 Worker。也是 IM 对话的接待面。")),
        ("worker", ("Worker", "执行者", "建独立 git worktree，改代码、跑测试、开 PR。绝不向 main 推送——交付物永远是一个待审的 PR。")),
        ("auditor", ("Auditor", "审计员", "只读审查 PR diff，给出 VERDICT：LGTM 或 CHANGES。不写代码、不合并，是质量闸门。")),
        ("redline", ("Redline", "红线守卫", "PreToolUse hook，对每次工具调用做确定性匹配。命中危险操作直接 deny——这是不依赖模型自觉的硬约束。")),
    ])
    role_cards = ""
    for role, (name, sub, desc) in role_meta.items():
        cnt = rc.get(role, 0)
        extra = ""
        if role == "redline":
            extra = (f'<div class="role-stat"><b>{stats["redline_deny"]}</b> 次确定性拦截 '
                     f'<span class="role-stat-sub">/ {stats["redline_warn"]} 次告警</span></div>')
        elif role == "worker":
            wsec = fmt_dur(stats["worker_secs"]) or "0s"
            extra = f'<div class="role-stat"><b>{stats["pr_runs"]}</b> 个 PR · 累计 {esc(wsec)}</div>'
        role_cards += (
            f'<article class="role-card rc-{role}">'
            f'<div class="rc-glyph rc-glyph-{role}" aria-hidden="true"></div>'
            f'<div class="rc-head">'
            f'<span class="rc-name">{esc(name)}</span>'
            f'<span class="rc-sub">{esc(sub)}</span>'
            f'</div>'
            f'<p class="rc-desc">{esc(desc)}</p>'
            f'<div class="rc-foot">'
            f'<span class="rc-count">{cnt}</span><span class="rc-count-lbl">条作战记录</span>'
            f'{extra}'
            f'</div>'
            f'</article>'
        )

    # ---- KPI ----
    closed_n = stats["closed_n"]
    closed_list = "、".join(f"cue#{i}" for i in stats["closed_issues"]) or "—"
    sr = stats["success_rate"]
    sr_disp = f"{sr:.0f}" if sr == int(sr) else f"{sr:.1f}"

    # pipeline 阶段
    pipeline_stages = [
        ("Issue", "GitHub 报障", "io"),
        ("PM", "分诊 / 派工", "pm"),
        ("Worker", "worktree → 改码 → 测试 → PR", "worker"),
        ("PR", "待审", "io"),
        ("Auditor", "只读审查 → VERDICT", "auditor"),
        ("审批", "IM 卡片 · 人点批准", "human"),
        ("合并", "自动 merge", "io"),
    ]
    pipe_html = ""
    for i, (label, sub, kind) in enumerate(pipeline_stages):
        pipe_html += (
            f'<div class="pipe-node pn-{kind}">'
            f'<div class="pipe-chip">{esc(label)}</div>'
            f'<div class="pipe-sub">{esc(sub)}</div>'
            f'</div>'
        )
        if i < len(pipeline_stages) - 1:
            pipe_html += '<div class="pipe-arrow" aria-hidden="true"><svg viewBox="0 0 28 12" width="28" height="12"><path d="M0 6 H22 M17 1 L23 6 L17 11" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></div>'

    # 时间跨度
    span_txt = "—"
    if stats["first_dt"] and stats["last_dt"]:
        span_txt = f'{fmt_dt_cst(stats["first_dt"], with_time=False)} — {fmt_dt_cst(stats["last_dt"], with_time=False)}'

    data_json = json.dumps(records, ensure_ascii=False)

    # ============================ HTML ============================
    return f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 军团 · 作战日志看板</title>
<meta name="description" content="一个自治多 agent 软件组织的对外作战日志：PM 分诊、Worker 开 PR、Auditor 审查、Redline 红线守卫，端到端闭环已实跑。">
<style>
:root {{
  --bg:        #0a0d11;
  --bg-grid:   #0e1318;
  --panel:     #11171e;
  --panel-2:   #161d26;
  --line:      #1f2832;
  --line-soft: #18202a;
  --ink:       #e7edf3;
  --ink-2:     #9aa9b8;
  --ink-3:     #5f6f7e;
  --amber:     #f0b429;     /* 主信号：作战室琥珀 */
  --amber-dim: #8a6a16;
  --pm:        #38bdf8;     /* cyan */
  --worker:    #34d399;     /* green */
  --auditor:   #a78bfa;     /* violet */
  --redline:   #f4584e;     /* red */
  --human:     #f0b429;     /* amber */
  --io:        #5f6f7e;     /* neutral */
  --ok:        #34d399;
  --warn:      #f0b429;
  --deny:      #f4584e;
  --fail:      #f4584e;
  --mono: ui-monospace, "SF Mono", "JetBrains Mono", "Cascadia Code", "Menlo", "Consolas", "Noto Sans Mono CJK SC", monospace;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
}}
