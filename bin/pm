#!/usr/bin/env bash
# 直接对话 PM —— 在 ~/army 下起【交互】Claude Code（自动加载 ~/army/CLAUDE.md）+ 注入 PM 角色手册。
# 用法：
#   pm                     # 进入交互对话
#   pm "看下 cue 的 #12"    # 带首句开聊
#
# 这是 PM 的「本地直连」通道，和 Telegram 是【同一个 PM 角色】——都从持久层
# (GitHub Issue/Projects + pyf-docs + runs.jsonl) 水合，看到同一个世界；不同的只是触发方式。
# 注：故意【不挂 army-guard】——PAUSE 是给自动任务的；你本人随时可找 PM 聊，
#     甚至正是用这个会话来决定要不要 resume 军团。
cd ~/army || exit 1
exec claude --append-system-prompt "$(cat ~/army/roles/pm.md)" --model opus "$@"
